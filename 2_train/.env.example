# MinIO connection used by 2_train/train.ipynb.
# Copy to .env and adjust. Every value has a default in code, so .env is optional.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
# S3 bucket names may only contain lowercase letters, digits, dots and hyphens.
MINIO_BUCKET=nexgen-example
MINIO_MODEL_KEY=catboost_model.cbm
